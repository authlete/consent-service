# The consent system-of-record. Local file for dev; a Turso/libSQL URL
# (libsql://…) for production (Vercel's filesystem is read-only, so a file: DB
# won't work there). For Turso, also set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/consent.sqlite
DATABASE_AUTH_TOKEN=

# This service's public URL — its issuer identity + the consent-leg base.
CONSENT_BASE_URL=http://localhost:3002

# The AS this service sits behind — its issuer identity, JWKS, resume target, and
# the OIDC provider we log signers in against. A correctly-provisioned AS uses
# this same URL as its OIDC issuer.
AS_BASE_URL=http://localhost:3000

# Private ES256 key for the mutual-JWT with the AS (and the self-signed session
# cookies). Generate one:  npm run keygen   (public half at /.well-known/jwks.json)
CONSENT_SIGNING_JWKS=

# Listen port for `npm run dev` / `npm start`.
PORT=3002

# This service as a first-party OIDC client of the AS: every signer (incl. the
# resource owner) proves identity via a standard OIDC login → id_token `sub`.
# Register a confidential client on the AS with redirect_uri
# <CONSENT_BASE_URL>/oidc/callback, mark it first_party=true, then set:
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
